","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"vfD7L9yKaW"}],"identifier":"fluxpy.eddy_covariance.band_covariance_random_error","label":"fluxpy.eddy_covariance.band_covariance_random_error","kind":"heading","template":"{name}","resolved":true,"html_id":"fluxpy-eddy-covariance-band-covariance-random-error","remote":true,"url":"/docs/api/fluxpy-eddy-covariance","dataUrl":"/docs.api.fluxpy-eddy-covariance.json","key":"r5pOUi5Otw"},{"type":"text","value":", ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"MKtUwh9A33"},{"type":"crossReference","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"inlineCode","value":"fluxpy.qc.segment_spectra","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"kZtVHjwYR1"}],"identifier":"fluxpy.qc.segment_spectra","label":"fluxpy.qc.segment_spectra","kind":"heading","template":"{name}","resolved":true,"html_id":"fluxpy-qc-segment-spectra","remote":true,"url":"/docs/api/fluxpy-qc","dataUrl":"/docs.api.fluxpy-qc.json","key":"ZsX91Zr3nk"},{"type":"text","value":", ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"xJvtC5e0oz"},{"type":"crossReference","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"inlineCode","value":"fluxpy.util.add_theta","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"Daqs1AaK0T"}],"identifier":"fluxpy.util.add_theta","label":"fluxpy.util.add_theta","kind":"heading","template":"{name}","resolved":true,"html_id":"fluxpy-util-add-theta","remote":true,"url":"/docs/api/fluxpy-util","dataUrl":"/docs.api.fluxpy-util.json","key":"SZDcGUaSBa"},{"type":"text","value":".","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"y2jYle6P7u"}],"key":"FHXUy3DTlT"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Source code (figures_manuscript/figA1_spectral_qc.py)","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"gQqhbgOLTw"}],"key":"H1t4WPvpCm"},{"type":"code","lang":"python","value":"\"\"\"Figure A1 -- spectral diagnostics of the EC segments (fig:spectral_qc).\n\nOne line per 5-km T-Bird segment of the four low-level flight days, coloured\nby whether the segment's flux exceeds twice its random error; black line = median over the plotted segments.\n\n(a-d) power spectra of theta, w, u, v with -5/3 guides;\n(e)   frequency-weighted cospectrum f*C_wtheta;\n(f)   normalised ogive O_wtheta (fluxes above twice their random error only:\n      the normalisation by the total covariance is meaningless for a flux\n      that cannot be distinguished from zero).\n\"\"\"\nimport sys\nfrom pathlib import Path\n\nREPO = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(REPO))\n\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\nimport xarray as xr\nfrom matplotlib.lines import Line2D\nfrom scipy.signal import detrend\n\nfrom fluxpy import figstyle as fs\nfrom fluxpy.eddy_covariance import band_covariance, band_covariance_random_error\nfrom fluxpy.qc import segment_spectra\nfrom fluxpy.util import add_theta\n\nfs.apply()\n\n# ── Configuration ────────────────────────────────────────────────────────────\nFS = 100.0           # sampling frequency [Hz]\n\n# Line styles = CONTENT (detectability classes), not house styling.\nSTYLES = {\n    True:  dict(color=(0.4189584, 0.69487019, 0.79630958), linewidth=0.8, linestyle=\"-\", zorder=1),\n    False: dict(color=\"0.75\", linewidth=0.6, linestyle=\"-\", zorder=0),\n}\n\n# ── Segments of the paper and their 100 Hz data ──────────────────────────────\nFIG = xr.open_dataset(REPO / \"data/model_output/sensitivity_figure_data.nc\")\nSEG = xr.open_dataset(\n    REPO / \"data/observations/ar/analysis_ready_polar6_turbulent_fluxes_latest_5km.nc\"\n).sel(start_time=FIG[\"start_time\"].values)\nds_tb = xr.open_dataset(\n    REPO / \"data/observations/processed/t-bird_unified/noseboom_unified.nc\").sortby(\"time\")\n\nlist_of_qcs, detectable = [], []\nfor t0, t1 in zip(SEG[\"start_time\"].values, SEG[\"end_time\"].values):\n    data = add_theta(ds_tb.sel(time=slice(t0, t1))).dropna(dim=\"time\", how=\"any\")\n    list_of_qcs.append(segment_spectra(w=data[\"w\"].values, theta=data[\"theta\"].values,\n                                       u=data[\"u\"].values, v=data[\"v\"].values, fs=FS))\n    w, th = detrend(data[\"w\"].values), detrend(data[\"theta\"].values)\n    detectable.append(bool(abs(band_covariance(w, th, FS))\n                           > 2.0 * band_covariance_random_error(w, th, FS)))\nprint(f\"{len(list_of_qcs)} segments, {sum(detectable)} above twice their random error\")\n\n\n# ── Plot helpers ─────────────────────────────────────────────────────────────\ndef _add_flux_band(ax, f1=0.1, f2=20.0):\n    ax.axvspan(f1, f2, color=\"0.92\", zorder=-5)\n    ax.axvline(f1, color=\"k\", linestyle=\"-\", linewidth=0.7)\n    ax.axvline(f2, color=\"k\", linestyle=\"-\", linewidth=0.7)\n\n\ndef _add_minus53_guides(ax, f, anchor_idx=3):\n    fa = f[anchor_idx]\n    with np.errstate(divide=\"ignore\"):       # f[0] = 0 -> inf, not drawn\n        for k in range(-6, 2):\n            ax.loglog(f, 10.0 ** k * (f / fa) ** (-5 / 3),\n                      ls=\"--\", color=\"0.6\", linewidth=0.5)\n\n\ndef _plot_lines(ax, x_key, y_key, scale=1.0, only_detectable=False):\n    \"\"\"One line per segment plus the black median over the plotted segments.\"\"\"\n    rows = [(qc, d) for qc, d in zip(list_of_qcs, detectable) if d or not only_detectable]\n    n = min(min(len(qc[x_key]), len(qc[y_key])) for qc, _ in rows)\n    for qc, d in rows:\n        ax.plot(qc[x_key][1:n], qc[y_key][1:n] * scale, **STYLES[d])\n    med = np.nanmedian(np.array([qc[y_key][:n] for qc, _ in rows]), axis=0)\n    ax.plot(rows[0][0][x_key][1:n], med[1:] * scale, color=\"k\", lw=1.0, zorder=10)\n\n\n# ── Figure: (a-d) power spectra | (e) f-cospectrum, (f) ogive ────────────────\nfig, axs = plt.subplot_mosaic(\"AABB\\nCCDD\\nEEFF\", figsize=(fs.FULL_W, 15.0 * fs.CM))\n\nfor key, p_key, var_label, ylabel, ymin in [\n    (\"A\", \"P_theta\", r\"$\\theta$\", r\"$P_\\theta\\;(K^2\\,s)$\",      1e-6),\n    (\"B\", \"P_w\",     r\"$w$\",      r\"$P_w\\;(m^2\\,s^{-1})$\",      1e-6),\n    (\"C\", \"P_u\",     r\"$u$\",      r\"$P_u\\;(m^2\\,s^{-1})$\",      1e-5),\n    (\"D\", \"P_v\",     r\"$v$\",      r\"$P_v\\;(m^2\\,s^{-1})$\",      1e-5),\n]:\n    ax = axs[key]\n    ax.set_xscale(\"log\")\n    ax.set_yscale(\"log\")\n    ax.set_xlim(1e-2, 100.0)\n    ax.set_ylim(ymin, 1e0)\n    ax.set_yticks(10.0 ** np.arange(np.log10(ymin), 1))\n    _add_flux_band(ax)\n    _add_minus53_guides(ax, list_of_qcs[0][\"f\"])\n    _plot_lines(ax, \"f\", p_key)\n    ax.text(0.17, 0.92, var_label, transform=ax.transAxes, fontweight=\"bold\")\n    ax.set_ylabel(ylabel)\n\n# (e) frequency-weighted cospectrum, plotted x1000, i.e. in 1e-3 m K s-1\nax = axs[\"E\"]\nax.set_xscale(\"log\")\nax.set_xlim(1e-2, 100.0)\n_add_flux_band(ax)\nax.axhline(0, color=\"0.3\", lw=0.7)\n_plot_lines(ax, \"f\", \"f_cospectrum\", scale=1000.0)\nax.set_xlabel(\"f (Hz)\")\nax.set_ylabel(r\"$f\\,C_{w\\theta}\\;(10^{-3}\\,m\\,K\\,s^{-1})$\")\n\n# (f) normalised ogive, detectable fluxes only\nax = axs[\"F\"]\nax.set_xscale(\"log\")\nax.set_xlim(1e-2, 100.0)\nax.set_ylim(-0.5, 2.0)\n_add_flux_band(ax)\nax.axhline(0.0, color=\"0.3\", lw=0.7)\nax.axhline(1.0, color=\"0.3\", lw=0.7)\n_plot_lines(ax, \"f_fft\", \"ogive_norm\", only_detectable=True)\nax.set_xlabel(\"f (Hz)\")\nax.set_ylabel(r\"norm. $O_{w\\theta}$\")\n\n# panel letters just above the top-left axes corner, starting at the spine, so\n# they stay clear of the uppermost y tick labels (10^0, 2.0) on its left; local\n# variant of fs.panel_label, whose letters sat on those tick labels\nfor key, lab in zip(\"ABCDEF\", [\"(a)\", \"(b)\", \"(c)\", \"(d)\", \"(e)\", \"(f)\"]):\n    axs[key].annotate(lab, xy=(0, 1), xycoords=\"axes fraction\", xytext=(0, 5),\n                      textcoords=\"offset points\", fontweight=\"bold\", ha=\"left\", va=\"bottom\")\n\naxs[\"E\"].legend(\n    [Line2D([0], [0], **STYLES[True]), Line2D([0], [0], **STYLES[False]), Line2D([0], [0], color=\"k\", lw=1.0)],\n    [r\"$|H_\\mathrm{S}| > 2\\,\\sigma_\\mathrm{rand}$\", r\"$|H_\\mathrm{S}| \\leq 2\\,\\sigma_\\mathrm{rand}$\", \"median\"], loc=\"lower left\")\n\nfs.save(fig, \"figA1_spectral_qc\")","position":{"start":{"line":35,"column":1},"end":{"line":175,"column":1}},"key":"V3si9Rm38t"}],"key":"GKQGiU1u0N"}],"key":"Yyd312qz7W"}],"key":"rBNRSlg8p5"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Figure 7 · Sensitivity to the bulk configuration","short_title":"Fig. 7 · Sensitivity to the bulk configuration","url":"/docs/figures/fig07-sensitivity","group":"Figures"},"next":{"title":"Reproduction","url":"/docs/reproduce","group":"Code and data"}}},"domain":"http://localhost:3000"}