"data":{"kind":"file","org":"FranzFlink","repo":"bacsam2-flux-analysis","reference":"main","file":"fluxpy/uncertainty.py","from":43,"to":58,"raw":"https://raw.githubusercontent.com/FranzFlink/bacsam2-flux-analysis/main/fluxpy/uncertainty.py"},"internal":false,"protocol":"github","key":"fjJFT8Ps8C"}],"key":"zCY1bYK3Za"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Source code (fluxpy/uncertainty.py, lines 43–58)","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"DL9WifW5IR"}],"key":"DmwX6mhB4f"},{"type":"code","lang":"python","value":"def uncertainty_budget(fig: xr.Dataset) -> dict[str, np.ndarray]:\n    \"\"\"Per-segment 1-sigma uncertainties [W m-2] of Table 2: ``ec_random``,\n    ``ec_instrument``, ``ec_total``, ``ec_placement`` (cross-check), ``obs_bulk``, ``rs_bulk``.\"\"\"\n    H_ec = np.asarray(fig[\"H_obs_ec\"], dtype=float)\n    out = {\n        \"ec_random\":     np.asarray(fig[\"sigma_random_ec\"], dtype=float),\n        \"ec_instrument\": np.abs(H_ec) * REL_INSTRUMENT,\n        \"ec_placement\":  np.asarray(fig[\"sigma_placement\"], dtype=float),\n    }\n    out[\"ec_total\"] = np.sqrt(out[\"ec_random\"] ** 2 + out[\"ec_instrument\"] ** 2)\n    for key, (u_ts, u_ta, u_wind) in INPUT_UNCERTAINTY.items():\n        out[f\"{key}_bulk\"] = np.sqrt(\n            (central_difference(fig, f\"H_{key}_dTsfc\", \"dT\") * u_ts) ** 2\n            + (central_difference(fig, f\"H_{key}_dTair\", \"dT\") * u_ta) ** 2\n            + (central_difference(fig, f\"H_{key}_dU\", \"dU\") * u_wind) ** 2)\n    return out","position":{"start":{"line":109,"column":1},"end":{"line":126,"column":1}},"key":"dK5CcTFp5k"}],"key":"oqfUl2wQ0K"}],"key":"lX8y48qmAy"}],"key":"eDA52FTevv"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"fluxpy.sensitivity","short_title":"sensitivity","url":"/docs/api/fluxpy-sensitivity","group":"API reference"},"next":{"title":"fluxpy.util","short_title