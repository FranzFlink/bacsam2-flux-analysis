column":1},"end":{"line":32,"column":1}},"key":"f7WeCsm5IW"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"The script writes ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"voJEJYMXn3"},{"type":"inlineCode","value":"figures_manuscript/output/fig03_leg_length.pdf","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"wkBEMJu0rx"},{"type":"text","value":" and ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"x9X1Pq5svb"},{"type":"inlineCode","value":".png","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"X9EL7l9c9J"},{"type":"text","value":" at the printed width (one column, 8.3 cm); ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"XhVwseQXRO"},{"type":"inlineCode","value":"pixi run figures","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"xwHirXc1i9"},{"type":"text","value":" writes all figures. It uses ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"VJr8XIh9gG"},{"type":"link","url":"/docs/api/fluxpy-figstyle","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"inlineCode","value":"fluxpy.figstyle","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"Zcp1YhBXda"}],"urlSource":"../api/fluxpy.figstyle.md","dataUrl":"/docs.api.fluxpy-figstyle.json","internal":true,"protocol":"file","key":"RCea5upRCU"},{"type":"text","value":".","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"aUJIfE7Exd"}],"key":"YOymLVuilT"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Source code (figures_manuscript/fig03_leg_length.py)","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"vhRee4ppkh"}],"key":"p71HU6JtGN"},{"type":"code","lang":"python","value":"\"\"\"Fig. 3 (fig:ec_leg_length_sensitivity) -- EC flux vs the length of the averaging window.\n\nManuscript Sect. 3.1: why 5 km. Three stacked panels over the six low-level legs, sharing the\nwindow-length axis (labels under (c) only):\n(a) mean sub-window flux relative to the flux of the leg stretch the windows cover, H_sub/H_cov,\n    averaged over five positions of the window grid (mean, +-1 sigma over the legs whose flux is\n    at least 0.5 W m-2),\n(b) random error sigma_rand of the sub-window fluxes (median, quartiles),\n(c) fraction of sub-windows whose flux exceeds 1, 2 and 3 sigma_rand.\n\nData: scripts/ec_window_length.py -> data/observations/ar/ec_leg_length_sensitivity/\n\"\"\"\nimport sys\nfrom pathlib import Path\n\nREPO = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(REPO))\n\nimport matplotlib.ticker as mticker\nimport pandas as pd\nimport cmcrameri.cm as cmc\nimport numpy as np\n\nfrom fluxpy import figstyle as fs\n\nfs.apply()\n\n# ── Data ─────────────────────────────────────────────────────────────────────\nCSV = (REPO / \"data\" / \"observations\" / \"ar\" / \"ec_leg_length_sensitivity\"\n       / \"ec_sensitivity_summary.csv\")\ndf_raw = pd.read_csv(CSV)\ndf_sub = (df_raw[(df_raw[\"label\"] != \"full leg\") & (df_raw[\"length_km\"] >= 1.0)]\n          .sort_values(\"length_km\").reset_index(drop=True))\n\n# ── Colours (batlow: ratio, random error, and the 1/2/3 sigma curves) ────────\nC_BATLOW = cmc.batlow(np.linspace(0, 1, 4))\nC_RATIO = C_BATLOW[0]\nC_SIGMA = C_BATLOW[1]\nC_REF = \"goldenrod\"      # 5 km reference marker\n\nREF_LENGTH_KM = 5.0\n\n# ── Layout: three panels on one window-length axis, close together ───────────\nfig, axes = fs.figure(width=fs.COL_W, aspect=1.6, nrows=3, sharex=True)\nfig.get_layout_engine().set(h_pad=0.02, hspace=0.0)\n\nkw_eb = dict(lw=1.0, ms=3.5, mew=0.6, markeredgecolor=\"k\", elinewidth=0.8,\n             capsize=2.5, capthick=0.8, zorder=0, alpha=0.5, ecolor=\"k\")\n\n\ndef _fmt_xax(ax, xlim=(0.9, 31.0), bottom=False):\n    ax.set_xscale(\"log\")\n    ax.set_xlim(xlim)\n    ax.set_xticks([1, 2, 5, 10, 20, 30])\n    ax.get_xaxis().set_major_formatter(mticker.FormatStrFormatter(\"%d\"))   # integer labels\n    ax.get_xaxis().set_minor_formatter(mticker.NullFormatter())\n    if bottom:\n        ax.set_xlabel(\"Averaging window (km)\")\n    else:\n        ax.tick_params(axis=\"x\", labelbottom=False)                            # shared axis: labels under (c) only\n    ax.axvline(REF_LENGTH_KM, color=C_REF, lw=3.0, ls=\"--\", zorder=-1)\n\n\ndef _panel_label(ax, label):\n    \"\"\"Panel letter above the top-left axes corner, clear of the uppermost y tick label\n    and of the long y label of (b) (local variant of fs.panel_label, whose fixed 2 %\n    offset lets '(c)' sit on the '1.0').\"\"\"\n    ax.annotate(label, xy=(0, 1), xycoords=\"axes fraction\", xytext=(-6, 7),\n                textcoords=\"offset points\", fontweight=\"bold\", ha=\"left\", va=\"bottom\")\n\n\n# ── (a) Flux-capture ratio H_sub / H_cov ─────────────────────────────────────\nax = axes[0]\nvalid = df_sub[\"ratio_mean\"].notna() & df_sub[\"ratio_std\"].notna()\nx = df_sub.loc[valid, \"length_km\"].where(df_sub.loc[valid, \"length_km\"] <= 30.0)\ny = df_sub.loc[valid, \"ratio_mean\"]\nyerr = df_sub.loc[valid, \"ratio_std\"]\n\nax.plot(x, y, color=C_RATIO)\nax.errorbar(x, y, yerr=yerr, color=C_RATIO, fmt=\"o\",\n            label=r\"mean $\\pm1\\sigma$\", **kw_eb)                    # the y label names the ratio\nax.axhline(1.0, color=\"k\", lw=1.5, ls=\"--\", alpha=0.6, label=\"ratio = 1\")\n_fmt_xax(ax)\nax.set_ylabel(r\"$H_\\mathrm{S,sub}\\,/\\,H_\\mathrm{S,cov}$\")\nax.set_ylim(0.8, 1.2)                    # fixed +-20 %: the automatic range magnifies one leg's scatter\nax.legend(loc=\"upper left\")              # empty corner; lower right is crossed by the 5 km line\n_panel_label(ax, \"(a)\")\n\n# ── (b) random error of the sub-window flux (Finkelstein & Sims, 2001) ─────\nax = axes[1]\nvalid = df_sub[\"random_error_median\"].notna()\nx = df_sub.loc[valid, \"length_km\"]\ny = df_sub.loc[valid, \"random_error_median\"]\nyerr = [y - df_sub.loc[valid, \"random_error_p25\"], df_sub.loc[valid, \"random_error_p75\"] - y]\n\nax.plot(x, y, color=C_SIGMA)\nax.errorbar(x, y, yerr=yerr, fmt=\"s\", color=C_SIGMA,\n            label=r\"$\\sigma_\\mathrm{rand}$  (median, quartiles)\", **kw_eb)\n_fmt_xax(ax)\nax.set_ylim(bottom=0)\nax.set_ylabel(r\"Random error $\\sigma_\\mathrm{rand}$ (W m$^{-2}$)\")\nax.legend(loc=\"upper right\")\n_panel_label(ax, \"(b)\")\n\n# ── (c) share of sub-windows whose flux exceeds 1, 2, 3 x its random error ──\nax = axes[2]\nfor i, k in enumerate((1, 2, 3)):\n    col = f\"fraction_above_{k}sigma\"\n    valid = df_sub[col].notna()\n    ax.plot(df_sub.loc[valid, \"length_km\"], df_sub.loc[valid, col], marker=\"o\", ms=3, ls=\"-\", color=C_BATLOW[i],\n            label=rf\"$|H_\\mathrm{{S}}| > {k}\\,\\sigma_\\mathrm{{rand}}$\")\n_fmt_xax(ax, bottom=True)\nax.set_ylim(0, 1)\nax.set_ylabel(\"Fraction of sub-windows\")\nax.legend(loc=\"lower right\", handlelength=2.2)\n_panel_label(ax, \"(c)\")\nax.axvline(REF_LENGTH_KM, color=C_REF, lw=3.0, ls=\"--\", zorder=10)\n\nfs.save(fig, \"fig03_leg_length\")","position":{"start":{"line":37,"column":1},"end":{"line":157,"column":1}},"key":"FZo27KjWWZ"}],"key":"gZxbBfKppK"}],"key":"GxiMG2OKFO"}],"key":"vXgw9TGxTH"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Figure 2 · Thermodynamic inputs of the bulk estimates","short_title":"Fig. 2 · Thermodynamic inputs of the bulk estimates","url":"/docs/figures/fig02-meteo-overview","group":"Figures"},"next":{"title":"Figure 4 · Flux maps of the low-level flights","short_title":"Fig. 4 · Flux maps of the low-level flights","url":"/docs/figures/fig04-flux-maps","group":"Figures"}}},"domain":"http://localhost:3000"}