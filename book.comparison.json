warnings\nfrom pathlib import Path\nimport numpy as np, pandas as pd, xarray as xr\nimport matplotlib.pyplot as plt\nwarnings.filterwarnings(\"ignore\")\nREPO = Path(\"..\").resolve(); sys.path.insert(0, str(REPO))\nplt.rcParams.update({\"figure.dpi\": 110, \"figure.constrained_layout.use\": True, \"axes.grid\": True, \"grid.alpha\": 0.3, \"font.size\": 10})\n\nAR  = REPO / \"data/observations/ar\"\nFIG = xr.open_dataset(REPO / \"data/model_output/sensitivity_figure_data.nc\")      # all flux estimates on the segments\nSEG = xr.open_dataset(AR / \"analysis_ready_polar6_turbulent_fluxes_latest_5km.nc\").sel(start_time=FIG.start_time.values)\nEC  = FIG[\"H_obs_ec\"].values\n\nfrom fluxpy.sensitivity import skill_metrics\nimport logging; logging.disable(logging.INFO)\nNAMES = {\"H_obs_bulk\": \"H_S,obs,bulk  (measured inputs)\", \"H_rs_bulk\": \"H_S,RS,bulk   (MODIS + ERA5)\",\n         \"H_era_bulk\": \"H_S,ERA,bulk  (ERA5 only)\", \"H_era_diag\": \"H_S,ERA,diag  (ERA5's own flux)\", \"H_car_diag\": \"H_S,CAR,diag  (CARRA's own flux)\"}\nT = pd.to_datetime(FIG.start_time.values)\nLEG = np.cumsum(np.r_[0, np.diff(T.values) / np.timedelta64(1, \"m\")] > 10)          # a new leg after a gap of > 10 min\n\ndef r_leg(h):\n    \"\"\"correlation after removing the mean of every leg: only the variability along the legs counts\"\"\"\n    d = pd.DataFrame({\"ec\": EC, \"h\": h, \"leg\": LEG}).dropna()\n    a = d.groupby(\"leg\")[[\"ec\", \"h\"]].transform(lambda s: s - s.mean())\n    return np.corrcoef(a.ec, a.h)[0, 1]\n\nrows = {}\nfor key, name in NAMES.items():\n    h = FIG[key].values; ok = np.isfinite(h)\n    m = skill_metrics(EC, h, key)\n    rows[name] = {\"slope b\": m[\"slope\"], \"r\": m[\"r\"], \"r_leg\": r_leg(h), \"sd ratio\": m[\"std_ratio\"], \"bias (W m-2)\": m[\"bias\"],\n                  \"MAE (W m-2)\": np.mean(np.abs(h[ok] - EC[ok])), \"RMSE (W m-2)\": m[\"rmse\"], \"n\": m[\"n\"]}\nrows[\"zero flux  (H = 0 everywhere)\"] = {\"bias (W m-2)\": -EC.mean(), \"MAE (W m-2)\": np.mean(np.abs(EC)),\n                                        \"RMSE (W m-2)\": np.sqrt(np.mean(EC ** 2)), \"n\": EC.size}\ntable = pd.DataFrame(rows).T; table[\"n\"] = table[\"n\"].astype(int)\nstats = table.columns.drop(\"n\")                          # two decimals, also in the columns with a gap\ntable[stats] = table[stats].apply(lambda col: col.map(lambda v: \"–\" if pd.isna(v) else f\"{v:.2f}\"))\ntable","visibility":"hide","key":"WO2JHUOqKL"},{"type":"outputs","id":"S3BP7OHJHEyC_-i9TfkBr","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":1,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>slope b</th>\n      <th>r</th>\n      <th>r_leg</th>\n      <th>sd ratio</th>\n      <th>bias (W m-2)</th>\n      <th>MAE (W m-2)</th>\n      <th>RMSE (W m-2)</th>\n      <th>n</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>H_S,obs,bulk&nbsp;&nbsp;(measured inputs)</th>\n      <td>1.23</td>\n      <td>0.77</td>\n      <td>0.63</td>\n      <td>1.60</td>\n      <td>0.47</td>\n      <td>1.75</td>\n      <td>4.07</td>\n      <td>91</td>\n    </tr>\n    <tr>\n      <th>H_S,RS,bulk&nbsp;&nbsp; (MODIS + ERA5)</th>\n      <td>0.59</td>\n      <td>0.48</td>\n      <td>0.14</td>\n      <td>1.21</td>\n      <td>-3.05</td>\n      <td>3.57</td>\n      <td>5.32</td>\n      <td>91</td>\n    </tr>\n    <tr>\n      <th>H_S,ERA,bulk&nbsp;&nbsp;(ERA5 only)</th>\n      <td>0.31</td>\n      <td>0.36</td>\n      <td>-0.24</td>\n      <td>0.88</td>\n      <td>-3.84</td>\n      <td>3.93</td>\n      <td>5.64</td>\n      <td>91</td>\n    </tr>\n    <tr>\n      <th>H_S,ERA,diag&nbsp;&nbsp;(ERA5's own flux)</th>\n      <td>1.10</td>\n      <td>0.56</td>\n      <td>-0.19</td>\n      <td>1.97</td>\n      <td>-2.59</td>\n      <td>4.62</td>\n      <td>6.78</td>\n      <td>91</td>\n    </tr>\n    <tr>\n      <th>H_S,CAR,diag&nbsp;&nbsp;(CARRA's own flux)</th>\n      <td>1.40</td>\n      <td>0.72</td>\n      <td>0.26</td>\n      <td>1.95</td>\n      <td>-3.36</td>\n      <td>4.61</td>\n      <td>6.80</td>\n      <td>74</td>\n    </tr>\n    <tr>\n      <th>zero flux&nbsp;&nbsp;(H = 0 everywhere)</th>\n      <td>–</td>\n      <td>–</td>\n      <td>–</td>\n      <td>–</td>\n      <td>-1.72</td>\n      <td>2.97</td>\n      <td>4.20</td>\n      <td>91</td>\n    </tr>\n  </tbody>\n</table>\n</div>","content_type":"text/html"},"text/plain":{"content":"                                 slope b     r  r_leg sd ratio bias (W m-2)  \\\nH_S,obs,bulk  (measured inputs)     1.23  0.77   0.63     1.60         0.47   \nH_S,RS,bulk   (MODIS + ERA5)        0.59  0.48   0.14     1.21        -3.05   \nH_S,ERA,bulk  (ERA5 only)           0.31  0.36  -0.24     0.88        -3.84   \nH_S,ERA,diag  (ERA5's own flux)     1.10  0.56  -0.19     1.97        -2.59   \nH_S,CAR,diag  (CARRA's own flux)    1.40  0.72   0.26     1.95        -3.36   \nzero flux  (H = 0 everywhere)          –     –      –        –        -1.72   \n\n                                 MAE (W m-2) RMSE (W m-2)   n  \nH_S,obs,bulk  (measured inputs)         1.75         4.07  91  \nH_S,RS,bulk   (MODIS + ERA5)            3.57         5.32  91  \nH_S,ERA,bulk  (ERA5 only)               3.93         5.64  91  \nH_S,ERA,diag  (ERA5's own flux)         4.62         6.78  91  \nH_S,CAR,diag  (CARRA's own flux)        4.61         6.80  74  \nzero flux  (H = 0 everywhere)           2.97         4.20  91  ","content_type":"text/plain"}}},"children":[],"key":"feYrs04q81"}],"visibility":"show","key":"GqBym7rwmF"}],"visibility":"show","key":"ow0rSA12kA"},{"type":"block","kind":"notebook-content","children":[