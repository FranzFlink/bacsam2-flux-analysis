e rs_* pathway of the matching ‘","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"uSFBbatP4u"},{"type":"text","value":"_era5only’ run; diag metrics\nare computed from sensitivity_figure_data.nc against the EC reference.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"w15yqAqYqN"}],"key":"rVk8PfTw8j"},{"type":"heading","depth":2,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Reproduction","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"Byj09EQJy4"}],"identifier":"reproduction","label":"Reproduction","html_id":"reproduction","implicit":true,"key":"WimX6XdDPw"},{"type":"code","lang":"bash","value":"pixi run python figures_manuscript/fig07_sensitivity.py","position":{"start":{"line":30,"column":1},"end":{"line":32,"column":1}},"key":"DtGPalfsZ9"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"The script writes ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"tqjCaS8TgE"},{"type":"inlineCode","value":"figures_manuscript/output/fig07_sensitivity.pdf","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"SSd7FBOoG4"},{"type":"text","value":" and ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"g7qndzcVJr"},{"type":"inlineCode","value":".png","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"LsW77wVLF8"},{"type":"text","value":" at the printed width (one column, 8.3 cm); ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"RseWSO2ZnR"},{"type":"inlineCode","value":"pixi run figures","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"bQ386CAUek"},{"type":"text","value":" writes all figures. It uses ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"wmBEfUiluW"},{"type":"link","url":"/docs/api/fluxpy-figstyle","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"inlineCode","value":"fluxpy.figstyle","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"yqbOvyd8Ts"}],"urlSource":"../api/fluxpy.figstyle.md","dataUrl":"/docs.api.fluxpy-figstyle.json","internal":true,"protocol":"file","key":"wDmp0dLi7R"},{"type":"text","value":".","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"e2CPUTEqn6"}],"key":"lSGmy9gLDo"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Source code (figures_manuscript/fig07_sensitivity.py)","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"a59fheG28h"}],"key":"zc8qJ2AMR0"},{"type":"code","lang":"python","value":"\"\"\"Fig. 7 (fig:sensitivity_summary) — sensitivity in the slope/r framework (manuscript Sect. 4.2).\n\nTornado-chart layout: three shared-y panels, (a) regression slope b on the EC\nreference (ideal 1), (b) correlation r, (c) bias (ideal 0). Each configuration\nrow shows the three offline bulk estimates as dots (T-Bird green, ERA5-MODIS\norange, ERA5-only blue; no connector line); the model-diagnosed\nERA5/CARRA fluxes are the dashed vertical benchmark lines. Representative\nconfigurations only (full matrix: Table C1).\n\nData: obs_*/rs_* metrics from sensitivity_summary_table.csv; the ERA5-only\nbulk is the rs_* pathway of the matching '<label>_era5only' run; diag metrics\nare computed from sensitivity_figure_data.nc against the EC reference.\n\nRun:  pixi run python figures_manuscript/fig07_sensitivity.py\n\"\"\"\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport xarray as xr\nfrom matplotlib.lines import Line2D\n\nREPO = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(REPO))\nfrom fluxpy import figstyle as fs  # noqa: E402\n\nfs.apply()\n\ndf = pd.read_csv(REPO / \"data/model_output/sensitivity_summary_table.csv\").set_index(\"label\")\nFIG = xr.open_dataset(REPO / \"data/model_output/sensitivity_figure_data.nc\")\nEC = np.asarray(FIG[\"H_obs_ec\"])\n\n\ndef diag_metrics(key):\n    \"\"\"(slope, r, bias) of a model-diagnosed flux against the EC reference.\"\"\"\n    h = np.asarray(FIG[key])\n    m = np.isfinite(h) & np.isfinite(EC)\n    return (float(np.polyfit(EC[m], h[m], 1)[0]),\n            float(np.corrcoef(EC[m], h[m])[0, 1]),\n            float(np.mean(h[m] - EC[m])))\n\n\n# (\"header\", text) rows get no tick and a thin separator line above them;\n# (\"diag\", label, var) rows carry ONE dot — the model-diagnosed fluxes do not\n# depend on the bulk configuration.\nROWS = [\n    (\"row\", \"Reference ($\\\\alpha_T = 10^{-1}$)\", \"GLGS20_ref\"),\n    (\"row\", \"$\\\\alpha_T = 10^{-2}$ (amplitude-matched)\", \"GLGS20_ztr1e-02\"),\n    (\"header\", \"Stability scheme\"),\n    (\"row\", \"Businger–Dyer\", \"BD_ref\"),\n    (\"row\", \"SHEBA (GAFGP07)\", \"GAFGP07_ref\"),\n    (\"row\", \"ZE07-I\", \"ZE07-I_ref\"),\n    (\"header\", \"Momentum roughness\"),\n    (\"row\", \"MOSAiC set\", \"GLGS20_mosaic\"),\n    (\"row\", \"Schnierstein set\", \"GLGS20_nschnier\"),\n    (\"row\", \"$4{\\\\times}10^{-4}$ m uniform\", \"GLGS20_z0c4e-04\"),\n    (\"header\", \"Model-diagnosed\"),\n    (\"diag\", \"ERA5\", \"H_era_diag\"),\n    (\"diag\", \"CARRA$^{*}$\", \"H_car_diag\"),\n]\n\nPANELS = [(\"slope\", \"Slope $b$\", (0.0, 2.4), [0, 1, 2], 1.0),\n          (\"r\", \"Corr. $r$\", (0.25, 0.80), [0.3, 0.7], None),\n          (\"bias\", \"Bias\\n(W$\\\\,$m$^{-2}$)\", (-4.6, 4.6), [-4, 0, 4], 0.0)]\nDIAG = {k: dict(zip((\"slope\", \"r\", \"bias\"), diag_metrics(k)))\n        for k in (\"H_era_diag\", \"H_car_diag\")}\n\n\ndef row_values(label, metric):\n    \"\"\"(T-Bird, ERA5-MODIS, ERA5-only) value triple for one configuration.\"\"\"\n    return (df.loc[label, f\"obs_{metric}\"],\n            df.loc[label, f\"rs_{metric}\"],\n            df.loc[f\"{label}_era5only\", f\"rs_{metric}\"])\n\n\nfig, axes = fs.figure(width=fs.COL_W, aspect=0.95, ncols=3, sharey=True)\nypos = {}                      # y position of every entry, top to bottom\nfor i, entry in enumerate(ROWS):\n    ypos[i] = -float(i)\ntick_rows = [(ypos[i], e[1]) for i, e in enumerate(ROWS) if e[0] != \"header\"]\nheaders = [(ypos[i], e[1]) for i, e in enumerate(ROWS) if e[0] == \"header\"]\n\nfor ax, (metric, xlab, xlim, ticks, ideal) in zip(axes, PANELS):\n    for j, (yy, _) in enumerate(tick_rows):               # zebra banding\n        if j % 2 == 0:\n            ax.axhspan(yy - 0.5, yy + 0.5, color=\"0.94\", zorder=0)\n    for yy, _ in headers:                                 # thin section separators\n        ax.axhline(yy + 0.5, color=\"0.75\", lw=0.5, zorder=1)\n    if ideal is not None:\n        ax.axvline(ideal, color=\"0.35\", lw=0.8, ls=\"--\", zorder=1)\n    for i, entry in enumerate(ROWS):\n        yy = ypos[i]\n        if entry[0] == \"row\":\n            vo, vr, ve = row_values(entry[2], metric)\n            # no connector between the three dots: there are no values between them\n            for v, key in [(vo, \"H_obs_bulk\"), (vr, \"H_rs_bulk\"), (ve, \"H_era_bulk\")]:\n                ax.plot(v, yy, \"o\", ms=4.5, color=fs.C[key], mec=\"white\", mew=0.5,\n                        zorder=4)\n        elif entry[0] == \"diag\":                          # one dot, no configuration\n            ax.plot(DIAG[entry[2]][metric], yy, \"o\", ms=4.5, color=fs.C[entry[2]],\n                    mec=\"white\", mew=0.5, zorder=4)\n    ax.set_xlim(xlim)\n    ax.set_xticks(ticks)\n    ax.set_xlabel(xlab)\n    ax.set_ylim(min(ypos.values()) - 0.6, 0.6)\n    ax.tick_params(axis=\"y\", length=0)\n\naxes[0].set_yticks([yy for yy, _ in tick_rows])\naxes[0].set_yticklabels([lbl for _, lbl in tick_rows])\naxes[0].get_yticklabels()[0].set_fontweight(\"bold\")\nfor yy, text in headers:                                  # tickless header labels\n    axes[0].text(-0.06, yy, text, transform=axes[0].get_yaxis_transform(),\n                 ha=\"right\", va=\"center\", fontstyle=\"italic\", color=\"0.35\")\n\nfig.legend(handles=[\n    Line2D([0], [0], marker=\"o\", lw=0, color=fs.C[\"H_obs_bulk\"], ms=4.5,\n           mec=\"white\", mew=0.5, label=fs.L[\"H_obs_bulk\"]),\n    Line2D([0], [0], marker=\"o\", lw=0, color=fs.C[\"H_rs_bulk\"], ms=4.5,\n           mec=\"white\", mew=0.5, label=fs.L[\"H_rs_bulk\"]),\n    Line2D([0], [0], marker=\"o\", lw=0, color=fs.C[\"H_era_bulk\"], ms=4.5,\n           mec=\"white\", mew=0.5, label=fs.L[\"H_era_bulk\"]),\n    Line2D([0], [0], marker=\"o\", lw=0, color=fs.C[\"H_era_diag\"], ms=4.5,\n           mec=\"white\", mew=0.5, label=fs.L[\"H_era_diag\"]),\n    Line2D([0], [0], marker=\"o\", lw=0, color=fs.C[\"H_car_diag\"], ms=4.5,\n           mec=\"white\", mew=0.5, label=fs.L[\"H_car_diag\"])],\n    loc=\"outside upper center\", ncol=3, columnspacing=0.8, handlelength=1.2,\n    handletextpad=0.4)\n\nfor ax, lbl in zip(axes, [\"(a)\", \"(b)\", \"(c)\"]):\n    fs.panel_label(ax, lbl, x=0.06)\n\nfs.save(fig, \"fig07_sensitivity\")","position":{"start":{"line":37,"column":1},"end":{"line":171,"column":1}},"key":"Rv1SGW8vXr"}],"key":"epI5wBKXbE"}],"key":"NaTjpv6boS"}],"key":"FJ7M4xWBcT"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Figure 6 · Estimates against the eddy-covariance flux","short_title":"Fig. 6 · Estimates against the eddy-covariance flux","url":"/docs/figures/fig06-flux-scatter","group":"Figures"},"next":{"title":"Figure A1 · Spectral diagnostics of the eddy-covariance segments","short_title":"Fig. A1 · Spectral diagnostics of the eddy-covariance segments","url":"/docs/figures/figa1-spectral-qc","group":"Figures"}}},"domain":"http://localhost:3000"}